# ==============================================================================
# WorkSight Environment Configuration
# Copy to .env and replace all secrets before production deployment.
# ==============================================================================

# --- Application ---
APP_NAME=WorkSight
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Production / Docker uses PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://worksight:worksight_secure_pass@postgres:5432/worksight
# Local quick-start without Docker falls back to SQLite if DATABASE_URL is omitted:
DATABASE_URL=postgresql+psycopg2://worksight:worksight_secure_pass@localhost:5432/worksight

# --- Security & Cryptography ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-strong-64-char-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Fernet key for encrypting RTSP URLs & camera credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CAMERA_ENCRYPTION_KEY=

# --- Privacy & Video Retention ---
DEFAULT_VIDEO_RETENTION_DAYS=7
DEFAULT_EVENT_RETENTION_DAYS=90
RECORDING_STORAGE_DIR=./recordings
ENABLE_RAW_VIDEO_STORAGE=false

# --- AI Computer Vision (On-Premise) ---
AI_VISION_ENABLED=true
AI_MODEL_PATH=yolov8n.pt
AI_PERSON_CONFIDENCE_THRESHOLD=0.45
AI_FRAME_SAMPLE_FPS=2
AI_USE_GPU=false

# --- Simulated Development Feeds ---
# Clearly watermarked simulated feeds for development without physical cameras.
# Set to false in production environments with physical RTSP/ONVIF hardware.
ALLOW_SIMULATED_FEEDS=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
